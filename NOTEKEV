  condition: chrome_parent and suspicious_execution and not exclude_legitimate

level: high
tags:
  - attack.impact
  - attack.t1190
  - cve.2026.5281
  - threat_hunting.browser_escape

falsepositives:
  - Extensions or legitimate tools spawning processes from Chrome
  - System tools launched via Chrome protocol handlers
  - Troubleshooting scripts run by users within browser context

references:
  - https://nvd.nist.gov/vuln/detail/CVE-2026-5281
  - https://www.cisa.gov/known-exploited-vulnerabilities-catalog
