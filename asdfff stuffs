Broader search across all Windows/Sysmon process logs
index=<your_index> host=<HOSTNAME>
(
    "whoami" OR "ipconfig" OR "netsh" OR "arp -a" OR "net config" OR "wmic useraccount" OR "systeminfo" OR "Disk\\Enum" OR "printscr" OR "loader --load" OR "controller --shutdown"
)
| eval cmd=coalesce(CommandLine, Process_Command_Line, command, Message, "")
| eval cmd_l=lower(cmd)
| where match(cmd_l, "(?i)\bwhoami\b")
    OR match(cmd_l, "(?i)\bipconfig(\.exe)?\s+/all\b")
    OR match(cmd_l, "(?i)\bnetsh(\.exe)?\s+interface\s+show\b")
    OR match(cmd_l, "(?i)\barp(\.exe)?\s+-a\b")
    OR match(cmd_l, "(?i)\bnet(\.exe)?\s+config\b")
    OR match(cmd_l, "(?i)\bwmic(\.exe)?\s+useraccount\s+get\s+/all\b")
    OR match(cmd_l, "(?i)\bsysteminfo(\.exe)?\b")
    OR match(cmd_l, "(?i)disk\\enum")
    OR match(cmd_l, "(?i)\bprintscr\b")
    OR match(cmd_l, "(?i)\bloader\b.*--load")
    OR match(cmd_l, "(?i)\bcontroller\b.*--shutdown")
| table _time index sourcetype host source EventCode Image New_Process_Name ParentImage Creator_Process_Name User Account_Name cmd
| sort _time


Summarize the test execution by host/user
index=<your_index> sourcetype="XmlWinEventLog:Microsoft-Windows-Sysmon/Operational" EventCode=1 host=<HOSTNAME>
| eval cmd_l=lower(coalesce(CommandLine, ""))
| eval user=coalesce(User, user, Account_Name, SubjectUserName)
| eval matched_step=case(
    match(cmd_l, "(?i)\bwhoami\b"), "T1033 - whoami",
    match(cmd_l, "(?i)\bipconfig(\.exe)?\s+/all\b"), "T1016 - ipconfig /all",
    match(cmd_l, "(?i)\bnetsh(\.exe)?\s+interface\s+show\b"), "T1016 - netsh interface show",
    match(cmd_l, "(?i)\barp(\.exe)?\s+-a\b"), "T1016 - arp -a",
    match(cmd_l, "(?i)\bnet(\.exe)?\s+config\b"), "T1016 - net config",
    match(cmd_l, "(?i)\bwmic(\.exe)?\s+useraccount\s+get\s+/all\b"), "T1033 - wmic useraccount get /ALL",
    match(cmd_l, "(?i)\bsysteminfo(\.exe)?\b"), "T1082 - systeminfo",
    match(cmd_l, "(?i)disk\\enum"), "T1082 - reg query Disk Enum",
    match(cmd_l, "(?i)\bprintscr\b.*--window\s+desktop"), "T1113 - screen capture",
    match(cmd_l, "(?i)\bloader\b.*--load"), "loader activity",
    match(cmd_l, "(?i)\bcontroller\b.*--shutdown"), "controller shutdown"
)
| where isnotnull(matched_step)
| stats earliest(_time) as first_seen latest(_time) as last_seen
        values(matched_step) as matched_steps
        values(Image) as images
        values(ParentImage) as parent_images
        values(CommandLine) as command_lines
        count as event_count
  by host user
| convert ctime(first_seen) ctime(last_seen)
| sort first_seen


