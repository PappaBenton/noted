Sysmon process creation search

index=<your_index> sourcetype="XmlWinEventLog:Microsoft-Windows-Sysmon/Operational" EventCode=1 host=<HOSTNAME>
| eval cmd_l=lower(coalesce(CommandLine, Process_Command_Line, ""))
| eval image_l=lower(coalesce(Image, Process_Name, NewProcessName, ""))
| eval parent_l=lower(coalesce(ParentImage, ParentProcessName, ""))
| where match(cmd_l, "(?i)\bwhoami\b")
    OR match(cmd_l, "(?i)\bcmd\.exe\s+/c\s+whoami\b")
    OR match(cmd_l, "(?i)\bipconfig(\.exe)?\s+/all\b")
    OR match(cmd_l, "(?i)\bnetsh(\.exe)?\s+interface\s+show\b")
    OR match(cmd_l, "(?i)\barp(\.exe)?\s+-a\b")
    OR match(cmd_l, "(?i)\bnet(\.exe)?\s+config\b")
    OR match(cmd_l, "(?i)\bwmic(\.exe)?\s+useraccount\s+get\s+/all\b")
    OR match(cmd_l, "(?i)\bsysteminfo(\.exe)?\b")
    OR match(cmd_l, "(?i)\breg(\.exe)?\s+query\s+hklm\\system\\currentcontrolset\\services\\disk\\enum\b")
    OR match(cmd_l, "(?i)\bprintscr\b.*--window\s+desktop")
    OR match(cmd_l, "(?i)\bloader\b.*--load\s+run")
    OR match(cmd_l, "(?i)\bloader\b.*--load\s+printscr")
    OR match(cmd_l, "(?i)\bcontroller\b.*--shutdown")
| eval matched_step=case(
    match(cmd_l, "(?i)\bwhoami\b"), "whoami",
    match(cmd_l, "(?i)\bcmd\.exe\s+/c\s+whoami\b"), "cmd /c whoami",
    match(cmd_l, "(?i)\bipconfig(\.exe)?\s+/all\b"), "ipconfig /all",
    match(cmd_l, "(?i)\bnetsh(\.exe)?\s+interface\s+show\b"), "netsh interface show",
    match(cmd_l, "(?i)\barp(\.exe)?\s+-a\b"), "arp -a",
    match(cmd_l, "(?i)\bnet(\.exe)?\s+config\b"), "net config",
    match(cmd_l, "(?i)\bwmic(\.exe)?\s+useraccount\s+get\s+/all\b"), "wmic useraccount get /ALL",
    match(cmd_l, "(?i)\bsysteminfo(\.exe)?\b"), "systeminfo",
    match(cmd_l, "(?i)\breg(\.exe)?\s+query\s+hklm\\system\\currentcontrolset\\services\\disk\\enum\b"), "reg query Disk Enum",
    match(cmd_l, "(?i)\bprintscr\b.*--window\s+desktop"), "printscr screen capture",
    match(cmd_l, "(?i)\bloader\b.*--load\s+run"), "loader --load run",
    match(cmd_l, "(?i)\bloader\b.*--load\s+printscr"), "loader --load printscr",
    match(cmd_l, "(?i)\bcontroller\b.*--shutdown"), "controller --shutdown"
)
| table _time host User matched_step Image ParentImage CommandLine ProcessId ParentProcessId CurrentDirectory
| sort _time





